---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import CtaSection from '../../components/home/CtaSection.astro';
import { solutionSteps, solutionCapabilities } from '../../data/solutions';
import { ROUTES, SITE } from '../../utils/constants';
---

<BaseLayout
  title="Soluciones"
  description="Soluciones web de NOVUM SYSTEM: landing pages, páginas web corporativas, sitios web personalizados y optimización y evolución de sitios web."
  canonical={`${SITE.url}soluciones/`}
>
  <section class="page-hero section">
    <Container>
      <div class="page-hero__inner">
        <div class="page-hero__side">
          <span class="section-label">Soluciones</span>
          <span class="page-hero__index mono-label">[ 002 ]</span>
        </div>
        <div class="page-hero__main">
          <h1 class="page-hero__title">
            Soluciones web que
            <br />
            <span class="text-gradient">mueven tu negocio</span>
          </h1>
          <p class="page-hero__desc">
            Creamos la presencia digital que tu negocio necesita: landing pages,
            sitios web corporativos y proyectos personalizados, diseñados y
            desarrollados para ti.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="approach section" aria-labelledby="approach-heading">
    <Container>
      <h2 id="approach-heading" class="sr-only">Nuestro enfoque</h2>
      <ol class="approach__list">
        {solutionSteps.map((step) => (
          <li class="approach__row">
            <div class="approach__row-num mono-label">{step.number}</div>
            <div class="approach__row-content">
              <h3 class="approach__row-title">{step.title}</h3>
              <p class="approach__row-desc">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <section class="capabilities section" aria-labelledby="capabilities-heading">
    <Container>
      <div class="capabilities__heading">
        <span class="section-label" id="capabilities-heading">Soluciones</span>
        <h2 class="capabilities__title">
          Una web que conecta <span class="text-gradient">con tu audiencia</span>
        </h2>
        <p class="capabilities__desc">
          Enfocamos nuestro trabajo en el desarrollo web: desde landing pages hasta sitios web corporativos completos.
        </p>
      </div>

      <div class="capabilities__grid">
        {solutionCapabilities.map((capability, index) => (
          <article class="capability-card">
            <span class="capability-card__num mono-label">0{index + 1}</span>
            <h3 class="capability-card__title">{capability.title}</h3>
            <p class="capability-card__desc">{capability.description}</p>
            <span class="capability-card__line" aria-hidden="true"></span>
          </article>
        ))}
      </div>

      <div class="capabilities__cta">
        <a href={ROUTES.contacto} class="link-arrow">
          Conversemos sobre tu necesidad <span aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  .page-hero .page-hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-block: clamp(3.5rem, 2.5rem + 3vw, 5.5rem) clamp(3rem, 2rem + 3vw, 4.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero__side {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .page-hero__index {
    color: var(--color-accent);
  }

  .page-hero__title {
    font-size: clamp(2.25rem, 1.5rem + 3.5vw, 4.25rem);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-6);
  }

  .page-hero__desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 58ch;
  }

  /* Approach */
  .approach {
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(180deg, transparent, rgba(5, 8, 13, 0.55));
  }

  .approach__list {
    border-top: 1px solid var(--color-border);
  }

  .approach__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--color-border);
    transition: padding-left var(--duration-normal) var(--ease-out);
  }

  .approach__row:hover {
    padding-left: var(--space-4);
  }

  .approach__row-num {
    color: var(--color-accent-3);
    padding-top: 0.4rem;
  }

  .approach__row-title {
    font-size: clamp(1.375rem, 1rem + 1.4vw, 1.875rem);
    margin-bottom: var(--space-3);
  }

  .approach__row-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 62ch;
  }

  /* Capabilities */
  .capabilities__heading {
    max-width: 560px;
    margin-bottom: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .capabilities__title {
    font-size: clamp(1.875rem, 1.25rem + 3vw, 3rem);
    margin-bottom: var(--space-5);
  }

  .capabilities__desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .capabilities__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .capability-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.5rem, 3vw, 2rem);
    background: linear-gradient(180deg, var(--color-surface) 0%, rgba(13, 17, 23, 0.5) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out);
  }

  .capability-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-3px);
  }

  .capability-card__num {
    color: var(--color-accent-3);
  }

  .capability-card__title {
    font-size: var(--text-xl);
  }

  .capability-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .capability-card__line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent 60%);
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .capability-card:hover .capability-card__line {
    opacity: 1;
  }

  .capabilities__cta {
    margin-top: var(--space-12);
  }

  @media (min-width: 768px) {
    .page-hero__inner {
      grid-template-columns: 1fr 2.2fr;
      gap: var(--space-16);
    }

    .page-hero__side {
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
    }

    .approach__row {
      grid-template-columns: auto 1fr;
      gap: var(--space-12);
      align-items: start;
    }

    .capabilities__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .capabilities__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>