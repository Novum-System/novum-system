---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/common/Container.astro';
import { SITE } from '../../utils/constants';
---

<BaseLayout
  title="Contacto"
  description="Hablemos de tu proyecto web. Cuéntanos qué necesitas y diseñaremos la página web adecuada para tu negocio."
  canonical={`${SITE.url}contacto/`}
>
  <section class="contact section">
    <Container>
      <div class="contact__layout">
        <div class="contact__intro">
          <span class="section-label">Contacto</span>

          <h1 class="contact__title">
            Hablemos
            <br />
            <span class="text-gradient">de tu proyecto</span>
          </h1>

          <p class="contact__desc">
            Cuéntanos qué necesita tu sitio web. Analizamos tu contexto y te
            proponemos el enfoque más adecuado para tu proyecto.
          </p>

          <ul class="contact__steps">
            <li>
              <span class="contact__step-text">
                Nos escribes con tu necesidad
              </span>
            </li>
            <li>
              <span class="contact__step-text">
                Agendamos una conversación breve
              </span>
            </li>
            <li>
              <span class="contact__step-text">
                Definimos el siguiente paso
              </span>
            </li>
          </ul>
        </div>

        <div class="contact__panel">
          <div class="contact__panel-top">
            <span class="contact__panel-label mono-label">
              nuevo proyecto
            </span>
            <span class="contact__panel-pulse"></span>
          </div>

          <form
            class="contact__form"
            id="contact-form"
            aria-label="Formulario de contacto"
            action="https://formspree.io/f/xrppkrvj"
            method="POST"
            novalidate
          >
            <!-- Honeypot antispam: debe permanecer vacío. Formspree reconoce _gotcha. -->
            <div class="contact__honeypot" aria-hidden="true">
              <label for="website_confirm">No rellenar este campo</label>
              <input
                type="text"
                id="website_confirm"
                name="_gotcha"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            <div class="contact__field">
              <label for="name" class="contact__label">
                Nombre
              </label>

              <input
                type="text"
                id="name"
                name="name"
                class="contact__input"
                placeholder="Tu nombre"
                autocomplete="name"
                required
                minlength="2"
                maxlength="80"
                aria-describedby="name-error"
              />

              <span
                id="name-error"
                class="contact__error"
                role="alert"
              ></span>
            </div>

            <div class="contact__field">
              <label for="company" class="contact__label">
                Empresa
              </label>

              <input
                type="text"
                id="company"
                name="company"
                class="contact__input"
                placeholder="Tu empresa"
                autocomplete="organization"
                maxlength="100"
                aria-describedby="company-error"
              />

              <span
                id="company-error"
                class="contact__error"
                role="alert"
              ></span>
            </div>

            <div class="contact__field">
              <label for="email" class="contact__label">
                Correo
              </label>

              <input
                type="email"
                id="email"
                name="email"
                class="contact__input"
                placeholder="correo@empresa.com"
                autocomplete="email"
                maxlength="254"
                required
                aria-describedby="email-error"
              />

              <span
                id="email-error"
                class="contact__error"
                role="alert"
              ></span>
            </div>

            <div class="contact__field">
              <label for="message" class="contact__label">
                Mensaje
              </label>

              <textarea
                id="message"
                name="message"
                class="contact__textarea"
                rows="5"
                placeholder="Cuéntanos brevemente qué necesita tu sitio web..."
                required
                minlength="10"
                maxlength="1500"
                aria-describedby="message-error"
              ></textarea>

              <span
                id="message-error"
                class="contact__error"
                role="alert"
              ></span>
            </div>

            <button
              type="submit"
              class="btn btn--primary btn--lg contact__submit"
            >
              Enviar mensaje
            </button>

            <p
              class="contact__status"
              id="contact-status"
              role="status"
              aria-live="polite"
            ></p>
          </form>

          <p class="contact__note">
            Tus datos se usan únicamente para atender tu consulta.
          </p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-status');

  const messages = {
    valueMissing: 'Este campo es obligatorio.',
    typeMismatch: 'Introduce un correo electrónico válido.',
    tooShort: 'Introduce un texto más largo.',
    tooLong: 'El texto supera la longitud permitida.',
    fallback: 'Revisa este campo e inténtalo nuevamente.',
  };

  // Filtro básico, no infalible. Ajusta esta lista según las necesidades del sitio.
  const offensiveTerms = [
    'puta', 'puto', 'mierda', 'imbecil', 'idiota', 'estupido', 'estupida',
    'pendejo', 'pendeja', 'cojudo', 'cojuda', 'carajo', 'cagon', 'cagona',
  ];

  const COOLDOWN_MS = 30_000;
  const LAST_SEND_KEY = 'novum_contact_last_send';

  function normalizeText(value: string): string {
    return value
      .toLocaleLowerCase('es')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  function containsOffensiveTerm(value: string): boolean {
    const normalized = normalizeText(value);
    return offensiveTerms.some((term) => {
      const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      return new RegExp(`(^|[^a-z0-9])${escaped}([^a-z0-9]|$)`, 'i').test(normalized);
    });
  }

  if (form && status) {
    const submitButton = form.querySelector<HTMLButtonElement>('.contact__submit');
    const honeypot = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
    const fields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input:not([name="_gotcha"]), textarea'
      )
    );
    const messageField = form.querySelector<HTMLTextAreaElement>('#message');

    function setError(
      input: HTMLInputElement | HTMLTextAreaElement,
      message: string
    ) {
      const errorId = input.getAttribute('aria-describedby');
      const error = errorId ? document.getElementById(errorId) : null;
      const field = input.closest('.contact__field');

      if (message) {
        input.setAttribute('aria-invalid', 'true');
        if (error) error.textContent = message;
        field?.classList.add('contact__field--error');
      } else {
        input.removeAttribute('aria-invalid');
        if (error) error.textContent = '';
        field?.classList.remove('contact__field--error');
      }
    }

    function validateField(input: HTMLInputElement | HTMLTextAreaElement): boolean {
      let message = '';
      const value = input.value.trim();

      if (input.required && !value) {
        message = messages.valueMissing;
      } else if (input.type === 'email' && value) {
        // Validación de formato; no confirma que el buzón exista.
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
        if (!emailPattern.test(value) || !input.checkValidity()) {
          message = messages.typeMismatch;
        }
      }

      if (!message && value.length < input.minLength && input.required) {
        message = messages.tooShort;
      }
      if (!message && input.maxLength > 0 && value.length > input.maxLength) {
        message = messages.tooLong;
      }
      if (!message && !input.checkValidity()) {
        message = input.validity.tooShort
          ? messages.tooShort
          : input.validity.tooLong
            ? messages.tooLong
            : messages.fallback;
      }

      setError(input, message);
      return !message;
    }

    fields.forEach((input) => {
      input.addEventListener('blur', () => {
        if (input.dataset.touched === 'true') validateField(input);
      });
      input.addEventListener('input', () => {
        input.dataset.touched = 'true';
        validateField(input);
        status.textContent = '';
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitButton?.disabled) return;
      status.textContent = '';

      // Un honeypot lleno suele indicar un envío automatizado.
      if (honeypot?.value.trim()) {
        status.textContent = 'No se pudo procesar el formulario. Inténtalo nuevamente.';
        return;
      }

      let firstInvalid: HTMLInputElement | HTMLTextAreaElement | null = null;
      for (const input of fields) {
        input.dataset.touched = 'true';
        if (!validateField(input) && firstInvalid === null) firstInvalid = input;
      }
      if (firstInvalid) {
        status.textContent = 'Revisa los campos marcados para continuar.';
        firstInvalid.focus();
        return;
      }

      const name = form.querySelector<HTMLInputElement>('#name')?.value.trim() ?? '';
      const company = form.querySelector<HTMLInputElement>('#company')?.value.trim() ?? '';
      const message = messageField?.value.trim() ?? '';

      if (containsOffensiveTerm(`${name} ${company} ${message}`)) {
        if (messageField) {
          setError(messageField, 'El mensaje contiene expresiones no permitidas. Por favor, modifícalo.');
          messageField.focus();
        }
        status.textContent = 'Revisa el texto antes de enviar tu consulta.';
        return;
      }

      // Límite local orientativo: no es un límite por IP y se puede eludir.
      try {
        const lastSend = Number(localStorage.getItem(LAST_SEND_KEY) ?? '0');
        const remaining = COOLDOWN_MS - (Date.now() - lastSend);
        if (remaining > 0) {
          const seconds = Math.ceil(remaining / 1000);
          status.textContent = `Espera ${seconds} segundos antes de enviar otro mensaje.`;
          return;
        }
      } catch {
        // Si el almacenamiento está bloqueado, el formulario sigue funcionando.
      }

      const originalLabel = submitButton?.textContent ?? 'Enviar mensaje';
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Enviando...';
      }
      status.textContent = 'Enviando tu mensaje...';

      try {
        const formData = new FormData(form);
        fields.forEach((input) => formData.set(input.name, input.value.trim()));

        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) {
          let detail = '';
          try {
            const result = await response.json();
            detail = typeof result?.errors?.[0]?.message === 'string'
              ? result.errors[0].message
              : '';
          } catch {
            // Puede que el servidor no devuelva JSON.
          }
          if (response.status === 429) {
            throw new Error('Se alcanzó el límite de envíos. Espera un momento e inténtalo nuevamente.');
          }
          throw new Error(detail || `No se pudo enviar el formulario (${response.status}).`);
        }

        try {
          localStorage.setItem(LAST_SEND_KEY, String(Date.now()));
        } catch {
          // El envío ya se completó; no fallar por almacenamiento bloqueado.
        }

        form.reset();
        fields.forEach((input) => {
          delete input.dataset.touched;
          setError(input, '');
        });
        status.textContent = '¡Mensaje enviado correctamente! Nos pondremos en contacto contigo.';
      } catch (error) {
        console.error('Error al enviar el formulario:', error);
        status.textContent = error instanceof Error
          ? error.message
          : 'No se pudo enviar el mensaje. Comprueba tu conexión e inténtalo nuevamente.';
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = originalLabel;
        }
      }
    });
  }
</script>

<style>
    /* Campo invisible para visitantes; los bots que lo rellenen se filtran. */
  .contact__honeypot {
    position: absolute !important;
    left: -10000px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
  }
  .contact .contact__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
    align-items: start;
    padding-block: clamp(2rem, 1rem + 2vw, 3rem);
  }

  .contact__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 40rem;
  }

  .contact__title {
    font-size: clamp(2.5rem, 1.75rem + 4vw, 4.75rem);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-6);
  }

  .contact__desc {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 48ch;
    margin-bottom: var(--space-12);
  }

  .contact__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .contact__steps li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .contact__step-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }

  /* Panel / form */
  .contact__panel {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: linear-gradient(180deg, var(--color-surface), rgba(13, 17, 23, 0.4));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .contact__panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 191, 255, 0.5), transparent);
  }

  .contact__panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .contact__panel-label {
    letter-spacing: 0.22em;
  }

  .contact__panel-pulse {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-accent-3);
    box-shadow: 0 0 12px var(--color-accent-glow);
    animation: glow-pulse 2.4s var(--ease-in-out) infinite;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact__label {
    font-size: var(--text-sm);
    font-weight: 550;
    color: var(--color-text);
  }

  .contact__input,
  .contact__textarea {
    width: 100%;
    padding: 0.8125rem 1rem;
    background: rgba(8, 11, 16, 0.7);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .contact__input::placeholder,
  .contact__textarea::placeholder {
    color: var(--color-text-muted);
  }

  .contact__input:focus,
  .contact__textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(0, 191, 255, 0.14);
  }

  .contact__field--error .contact__input,
  .contact__field--error .contact__textarea {
    border-color: rgba(239, 68, 68, 0.65);
  }

  .contact__field--error .contact__input:focus,
  .contact__field--error .contact__textarea:focus {
    border-color: var(--color-error);
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.14);
  }

  .contact__error {
    min-height: 1.25rem;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-error);
  }

  .contact__textarea {
    resize: vertical;
    min-height: 128px;
  }

  .contact__submit {
    align-self: flex-start;
    margin-top: var(--space-2);
  }

  .contact__status {
    min-height: 1.25rem;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
  }

  .contact__note {
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .contact__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .contact__intro {
      margin-left: clamp(0rem, 3vw, 2.5rem);
    }
  }
</style>