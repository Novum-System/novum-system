---
import Button from '../common/Button.astro';
import { ROUTES } from '../../utils/constants';
---

<section class="hero" aria-label="Presentación de NOVUM SYSTEM">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__orb hero__orb--one"></div>
    <div class="hero__orb hero__orb--two"></div>
    <div class="hero__beam"></div>
    <div class="hero__scan"></div>
  </div>

  <div class="hero__container">
    <div class="hero__content">
      <div class="hero__text">
        <span class="hero__eyebrow animate-fade-in-up">
          <span class="hero__eyebrow-line"></span>
          NOVUM SYSTEM
        </span>
        <h1 class="hero__title animate-fade-in-up animate-delay-1">
          Tecnología que transforma <span class="text-gradient">ideas</span> en soluciones.
        </h1>
        <p class="hero__subtitle animate-fade-in-up animate-delay-2">
          Desarrollo de páginas web modernas, profesionales y adaptadas a
          las necesidades de cada negocio.
        </p>
        <div class="hero__actions animate-fade-in-up animate-delay-3">
          <Button href={ROUTES.contacto} size="lg">Hablemos</Button>
          <Button href={ROUTES.soluciones} variant="secondary" size="lg">
            Conocer soluciones
          </Button>
        </div>

        <div class="hero__meta animate-fade-in-up animate-delay-4">
          <span class="hero__meta-pulse"></span>
          <span class="hero__meta-text">Disponibles para nuevos proyectos</span>
          <span class="hero__meta-slash">/</span>
          <span class="hero__meta-text">novumsystem.online</span>
        </div>
      </div>

      <div class="hero__visual animate-fade-in animate-delay-2" aria-hidden="true">
        <div class="hero__orbit hero__orbit--outer"></div>
        <div class="hero__orbit hero__orbit--inner"></div>

        <!--
          Visual conceptual: dispositivo móvil mostrando una interfaz web.
          Cuando exista la imagen real (mano + smartphone) en el proyecto,
          colócala en /public (por ejemplo /novum-phone-hand.png) y sustituye
          el bloque .hero__device por:
          <img src="/novum-phone-hand.png" class="hero__device-img" alt="" />
        -->
        <div class="hero__device">
          <div class="hero__device-glow" aria-hidden="true"></div>
          <div class="hero__device-screen">
            <div class="hero__device-ui">
              <div class="hero__device-top">
                <span class="hero__device-pill"></span>
                <span class="hero__device-pulse"></span>
              </div>
              <div class="hero__device-body">
                <span class="hero__device-line hero__device-line--title"></span>
                <span class="hero__device-line hero__device-line--accent"></span>
                <span class="hero__device-line hero__device-line--w80"></span>
                <span class="hero__device-line hero__device-line--w66"></span>
                <span class="hero__device-line hero__device-line--w60"></span>
              </div>
              <div class="hero__device-cta"></div>
              <div class="hero__device-chips">
                <span class="hero__device-chip"></span>
                <span class="hero__device-chip hero__device-chip--dim"></span>
                <span class="hero__device-chip hero__device-chip--dim"></span>
              </div>
            </div>
          </div>
        </div>

        <div class="hero__badge hero__badge--tl mono-label">
          <span class="hero__badge-dot"></span>
          experiencia web
        </div>
        <div class="hero__badge hero__badge--br mono-label">
          [ modern · responsive ]
        </div>
      </div>
    </div>
  </div>

  <a href={ROUTES.servicios} class="hero__scroll" aria-label="Continuar a la sección de servicios">
    <span class="hero__scroll-label mono-label">Descubrir</span>
    <span class="hero__scroll-track"><span></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: var(--header-height);
  }

  .hero__container {
    width: 100%;
    max-width: calc(var(--container-max) + var(--container-padding) * 2);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  /* --- Background --- */
  .hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 72% 62% at 50% 42%, black 15%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 72% 62% at 50% 42%, black 15%, transparent 72%);
  }

  .hero__orb {
    position: absolute;
    border-radius: var(--radius-full);
    filter: blur(4px);
  }

  .hero__orb--one {
    top: 6%;
    right: -8%;
    width: 560px;
    height: 560px;
    background: radial-gradient(circle, rgba(0, 153, 255, 0.16) 0%, transparent 62%);
    animation: glow-pulse 7s var(--ease-in-out) infinite;
  }

  .hero__orb--two {
    bottom: -14%;
    left: -6%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, rgba(0, 191, 255, 0.12) 0%, transparent 60%);
    animation: glow-pulse 9s var(--ease-in-out) infinite reverse;
  }

  .hero__beam {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 58%;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(24, 213, 255, 0.18) 30%,
      rgba(0, 191, 255, 0.05) 70%,
      transparent
    );
    opacity: 0.7;
  }

  .hero__scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 62%,
      rgba(0, 191, 255, 0.04) 92%,
      transparent 100%
    );
  }

  /* --- Content grid --- */
  .hero__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 1.5rem + 3vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 2rem + 2vw, 4.5rem);
  }

  /* --- Text --- */
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent-3);
    margin-bottom: var(--space-6);
  }

  .hero__eyebrow-line {
    display: block;
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  .hero__title {
    font-size: clamp(2.25rem, 4.8vw, 5.2rem);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-6);
    max-width: 16ch;
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 48ch;
    margin-bottom: var(--space-10);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__meta-pulse {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--color-accent-3);
    box-shadow: 0 0 10px var(--color-accent-glow);
  }

  .hero__meta-slash {
    color: var(--color-accent);
  }

  /* --- Visual --- */
  .hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(320px, 38vw, 520px);
  }

  .hero__orbit {
    position: absolute;
    border-radius: var(--radius-full);
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  .hero__orbit--outer {
    width: clamp(250px, 30vw, 415px);
    height: clamp(250px, 30vw, 415px);
    border: 1px dashed rgba(0, 191, 255, 0.18);
    animation: orbit-spin 60s linear infinite;
  }

  .hero__orbit--outer::after,
  .hero__orbit--inner::after {
    content: '';
    position: absolute;
    top: -3px;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent-glow);
  }

  .hero__orbit--inner {
    width: clamp(200px, 24vw, 340px);
    height: clamp(200px, 24vw, 340px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    animation: orbit-spin 42s linear infinite reverse;
  }

  .hero__device {
    position: relative;
    z-index: 1;
    width: clamp(250px, 26vw, 360px);
    aspect-ratio: 3 / 4;
    padding: clamp(0.55rem, 1vw, 0.8rem);
    border-radius: clamp(1.75rem, 3vw, 2.5rem);
    background: linear-gradient(160deg, #1b2537 0%, #0b0f18 62%, #0e1622 100%);
    border: 1px solid rgba(0, 191, 255, 0.22);
    box-shadow:
      0 28px 70px rgba(0, 0, 0, 0.55),
      0 0 80px rgba(0, 153, 255, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .hero__device::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      140deg,
      rgba(0, 191, 255, 0.5),
      transparent 35%,
      transparent 68%,
      rgba(0, 153, 255, 0.28)
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  .hero__device-glow {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 145%;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle,
      rgba(0, 153, 255, 0.18) 0%,
      rgba(0, 191, 255, 0.08) 42%,
      transparent 68%
    );
  }

  .hero__device-screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(clamp(1.75rem, 3vw, 2.5rem) - clamp(0.55rem, 1vw, 0.8rem));
    background:
      radial-gradient(130% 70% at 82% -12%, rgba(0, 191, 255, 0.22), transparent 55%),
      radial-gradient(130% 80% at 8% 112%, rgba(0, 153, 255, 0.16), transparent 60%),
      linear-gradient(180deg, #0c1222 0%, #080c15 100%);
  }

  .hero__device-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.6), transparent 72%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.6), transparent 72%);
  }

  .hero__device-ui {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.1rem) clamp(0.9rem, 1.8vw, 1.25rem)
      clamp(1rem, 2vw, 1.35rem);
  }

  .hero__device-top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: clamp(1.1rem, 2.4vw, 1.6rem);
  }

  .hero__device-pill {
    flex: 1;
    height: clamp(0.68rem, 1.3vw, 0.86rem);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }

  .hero__device-pulse {
    width: clamp(0.45rem, 0.9vw, 0.55rem);
    height: clamp(0.45rem, 0.9vw, 0.55rem);
    border-radius: var(--radius-full);
    background: var(--color-accent-3);
    box-shadow: 0 0 8px var(--color-accent-glow);
  }

  .hero__device-body {
    display: flex;
    flex-direction: column;
    gap: clamp(0.45rem, 0.9vw, 0.58rem);
  }

  .hero__device-line {
    display: block;
    height: clamp(0.38rem, 0.8vw, 0.48rem);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.14);
  }

  .hero__device-line--title {
    width: 82%;
    height: clamp(0.95rem, 1.9vw, 1.18rem);
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.55));
  }

  .hero__device-line--accent {
    width: 56%;
    height: clamp(0.86rem, 1.7vw, 1.05rem);
    background: linear-gradient(90deg, var(--color-accent-3), var(--color-accent-2));
  }

  .hero__device-line--w80 {
    width: 80%;
  }

  .hero__device-line--w66 {
    width: 66%;
  }

  .hero__device-line--w60 {
    width: 60%;
  }

  .hero__device-cta {
    width: 62%;
    height: clamp(1.1rem, 2.2vw, 1.35rem);
    margin-top: clamp(1rem, 2vw, 1.4rem);
    border-radius: var(--radius-full);
    background: linear-gradient(120deg, var(--color-accent-hover), var(--color-accent-2));
    box-shadow: 0 0 18px rgba(0, 191, 255, 0.3);
  }

  .hero__device-chips {
    margin-top: auto;
    display: flex;
    gap: clamp(0.4rem, 0.8vw, 0.55rem);
  }

  .hero__device-chip {
    width: clamp(1.9rem, 4vw, 2.4rem);
    height: clamp(0.5rem, 1vw, 0.6rem);
    border-radius: var(--radius-full);
    background: rgba(0, 191, 255, 0.16);
    border: 1px solid rgba(0, 191, 255, 0.26);
  }

  .hero__device-chip--dim {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.09);
  }

  /* Floating badges */
  .hero__badge {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5rem 0.85rem;
    background: rgba(13, 17, 23, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .hero__badge--tl {
    top: 4%;
    left: -2%;
  }

  .hero__badge--br {
    bottom: 8%;
    right: -2%;
    color: var(--color-text-secondary);
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-accent-3);
    box-shadow: 0 0 8px var(--color-accent-glow);
  }

  /* --- Scroll indicator --- */
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 3vw, 2.5rem);
    translate: -50% 0;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    z-index: var(--z-above);
  }

  .hero__scroll-label {
    letter-spacing: 0.32em;
  }

  .hero__scroll-track {
    display: block;
    width: 1px;
    height: 44px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
    position: relative;
  }

  .hero__scroll-track span {
    position: absolute;
    inset: 0;
    background: var(--gradient-accent);
    animation: scroll-hint 2.6s var(--ease-in-out) infinite;
  }

  /* --- Responsive --- */
  @media (min-width: 768px) {
    .hero__eyebrow {
      margin-bottom: var(--space-10);
    }
  }

  @media (min-width: 1024px) {
    .hero__content {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-12);
    }
  }

  @media (min-width: 2560px) {
    .hero__device {
      max-width: 360px;
    }
  }
</style>