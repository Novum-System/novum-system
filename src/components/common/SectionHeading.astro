---
interface Props {
  id?: string;
  tagline?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { id, tagline, title, description, align = 'left' } = Astro.props;
---

<div
  id={id}
  class:list={['section-heading', `section-heading--${align}`]}
>
  {tagline && (
    <span class:list={['section-label', { 'section-label--center': align === 'center' }]}>
      {tagline}
    </span>
  )}
  <h2 class="section-heading__title">{title}</h2>
  {description && <p class="section-heading__desc">{description}</p>}
</div>