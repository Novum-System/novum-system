---
interface Props {
  class?: string;
  tag?: keyof HTMLElementTagNameMap;
}

const { class: className = '', tag: Tag = 'div' } = Astro.props;
---

<Tag class:list={['container', className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }
</style>
