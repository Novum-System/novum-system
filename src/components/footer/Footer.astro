---
import Container from '../common/Container.astro';
import Button from '../common/Button.astro';
import { mainNav } from '../../data/navigation';
import { company } from '../../data/company';
import { ROUTES } from '../../utils/constants';

const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <hr class="hairline" />
  <Container>
    <div class="footer__top">
      <div class="footer__brand">
        <a href={ROUTES.home} aria-label="NOVUM SYSTEM - Ir al inicio" class="footer__logo">
          <img
            src="/novum-system-logo-transparent-124.webp"
            srcset="/novum-system-logo-transparent-124.webp 1x, /novum-system-logo-transparent-248.webp 2x"
            alt="NOVUM SYSTEM"
            width="124"
            height="120"
            loading="lazy"
            decoding="async"
            class="footer__logo-img"
          />
        </a>
        <p class="footer__tagline">{company.tagline}</p>
      </div>

      <nav class="footer__nav" aria-label="Navegación del pie de página">
        <p class="footer__nav-title">Navegación</p>
        <ul class="footer__nav-list">
          {mainNav.map((item) => (
            <li>
              <a href={item.href} class="footer__link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer__cta">
        <p class="footer__nav-title">¿Tienes un proyecto en mente?</p>
        <p class="footer__cta-desc">
          Conversemos sobre cómo una página web profesional puede impulsar tu negocio.
        </p>
        <Button href={ROUTES.contacto} variant="primary">
          Hablemos
        </Button>
      </div>

      <div class="footer__social">
        <p class="footer__nav-title">Síguenos</p>
        <ul class="footer__social-list">
          <li>
            <a
              href="https://web.facebook.com/profile.php?id=61594245158403"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook de Novum System"
              class="footer__social-link"
            >
              <svg
                class="footer__social-icon"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                />
              </svg>
              Novum System
            </a>
          </li>
          <li>
            <a
              href="https://www.instagram.com/novumsystem.1/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de Novum System"
              class="footer__social-link"
            >
              <svg
                class="footer__social-icon"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"
                />
              </svg>
              @NovumSystem.1
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">&copy; {currentYear} NOVUM SYSTEM</p>
      <p class="footer__domain mono-label">novumsystem.online</p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    padding-bottom: calc(var(--space-8) + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, transparent, rgba(5, 8, 13, 0.6));
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    padding-block: clamp(3.5rem, 3rem + 3vw, 6rem) var(--space-12);
  }

  .footer__logo-img {
    width: clamp(88px, 7vw, 124px);
    height: auto;
    display: block;
    margin-bottom: var(--space-4);
    /* Logo transparente (oscuro) tonificado en claro para superficies oscuras */
    filter: brightness(0) invert(1);
  }

  .footer__tagline {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 34ch;
    line-height: var(--leading-relaxed);
  }

  .footer__nav-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .footer__nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.25rem;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--color-accent-3);
  }

  .footer__cta-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 34ch;
    margin-bottom: var(--space-6);
  }

  .footer__social-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .footer__social-link:hover {
    color: var(--color-accent-3);
    background-color: var(--color-accent-dim);
  }

  .footer__social-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
  }

  .footer__copy {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 768px) {
    .footer__top {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: var(--space-12);
    }
  }
</style>