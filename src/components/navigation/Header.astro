---
import { mainNav } from '../../data/navigation';
import { ROUTES } from '../../utils/constants';

const isActive = (href: string) =>
  href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---

<header class="header" role="banner">
  <div class="header__inner">
    <a href={ROUTES.home} class="header__logo" aria-label="NOVUM SYSTEM — Inicio">
      <img
        src="/novum-mark-192.png"
        alt=""
        width="192"
        height="192"
        loading="eager"
        decoding="async"
        class="header__logo-img"
      />
    </a>

    <nav class="header__desktop-nav" aria-label="Navegación principal">
      <ul class="header__nav-list">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'header__nav-link',
                { 'header__nav-link--active': isActive(item.href) },
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href={ROUTES.contacto} class="btn btn--primary btn--sm header__cta">
        Hablemos
      </a>
      <button
        class="header__menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="menu-toggle"
      >
        <span class="header__hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div
  class="mobile-menu"
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="mobile-menu__glow"></div>
  <nav aria-label="Navegación móvil">
    <ul class="mobile-menu__list">
      {mainNav.map((item, index) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'mobile-menu__link',
              { 'mobile-menu__link--active': isActive(item.href) },
            ]}
          >
            <span class="mobile-menu__number">0{index + 1}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <a href={ROUTES.contacto} class="btn btn--primary btn--lg mobile-menu__cta">
      Hablemos
    </a>
  </nav>
</div>

<script>
  function initHeader() {
    const header = document.querySelector('.header');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const mq = window.matchMedia('(min-width: 1024px)');

    if (header) {
      const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    if (!toggle || !menu) return;

    const links = Array.from(menu.querySelectorAll('a'));

    const openMenu = () => {
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú de navegación');
      menu.setAttribute('aria-hidden', 'false');
      document.body.classList.add('no-scroll');
      if (links[0]) links[0].focus();
    };

    const closeMenu = (returnFocus = true) => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú de navegación');
      menu.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('no-scroll');
      if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeMenu(true);
      } else {
        openMenu();
      }
    });

    links.forEach((link) => link.addEventListener('click', () => closeMenu(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu(true);
      }
    });

    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = Array.from(menu.querySelectorAll('a, button'));
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    const onViewportChange = () => {
      if (mq.matches && toggle.getAttribute('aria-expanded') === 'true') {
        closeMenu(false);
      }
    };
    mq.addEventListener('change', onViewportChange);
  }

  initHeader();
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    height: calc(var(--header-height) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    display: flex;
    align-items: center;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      backdrop-filter var(--duration-normal) var(--ease-out);
  }

  .header.is-scrolled {
    background: rgba(8, 11, 16, 0.68);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    border-bottom-color: rgba(255, 255, 255, 0.06);
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    max-width: calc(var(--container-max) + var(--container-padding) * 2);
    margin-inline: auto;
    padding-inline: calc(var(--container-padding) + env(safe-area-inset-left))
      calc(var(--container-padding) + env(safe-area-inset-right));
    height: 100%;
  }

  /* Logo (isotipo) */
  .header__logo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.4rem;
    margin-inline-end: var(--space-4);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: 0 0 22px rgba(0, 153, 255, 0.05);
    transition:
      background var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .header__logo:hover {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.04));
    box-shadow: 0 0 30px rgba(0, 191, 255, 0.09);
  }

  .header__logo-img {
    width: auto;
    height: clamp(38px, 4.2vw, 46px);
    display: block;
  }

  /* Desktop nav */
  .header__desktop-nav {
    display: none;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1vw, 1.5rem);
  }

  .header__nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.875rem;
    font-size: var(--text-sm);
    font-weight: 480;
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header__nav-link::after {
    content: '';
    position: absolute;
    left: 0.875rem;
    right: 0.875rem;
    bottom: 0.25rem;
    height: 1px;
    background: var(--gradient-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .header__nav-link:hover,
  .header__nav-link--active {
    color: var(--color-text);
  }

  .header__nav-link--active::after,
  .header__nav-link:hover::after {
    transform: scaleX(1);
  }

  /* Actions */
  .header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header__cta {
    display: none;
  }

  /* Hamburger */
  .header__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    transition:
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .header__menu-toggle:hover {
    background: var(--color-surface-raised);
    border-color: var(--color-border);
  }

  .header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 20px;
    height: 20px;
  }

  .header__hamburger span {
    display: block;
    height: 2px;
    width: 100%;
    border-radius: 2px;
    background: var(--color-text);
    transition:
      transform var(--duration-normal) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .header__menu-toggle[aria-expanded='true'] .header__hamburger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__menu-toggle[aria-expanded='true'] .header__hamburger span:nth-child(2) {
    opacity: 0;
  }

  .header__menu-toggle[aria-expanded='true'] .header__hamburger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    top: calc(var(--header-height) + env(safe-area-inset-top));
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 6vw, 4rem) var(--container-padding)
      calc(var(--space-10) + env(safe-area-inset-bottom));
    background:
      radial-gradient(500px 380px at 85% 8%, rgba(0, 153, 255, 0.14), transparent 65%),
      radial-gradient(420px 360px at 5% 96%, rgba(0, 191, 255, 0.1), transparent 60%),
      rgba(5, 8, 13, 0.97);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform var(--duration-normal) var(--ease-out),
      visibility 0s linear var(--duration-normal);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-menu[aria-hidden='false'] {
    transform: translateX(0);
    visibility: visible;
    transition:
      transform var(--duration-normal) var(--ease-out),
      visibility 0s;
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-6);
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 56px;
    padding: var(--space-4) 0;
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .mobile-menu__number {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .mobile-menu__link:hover,
  .mobile-menu__link--active {
    color: var(--color-text);
  }

  .mobile-menu__cta {
    margin-top: var(--space-8);
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .header__desktop-nav {
      display: block;
    }

    .header__cta {
      display: inline-flex;
    }

    .header__menu-toggle {
      display: none;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>